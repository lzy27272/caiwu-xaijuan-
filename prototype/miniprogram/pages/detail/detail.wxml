<view class="page detail">

  <!-- ---------- 单据不存在 ---------- -->
  <view class="card lost" wx:if="{{!found}}">
    <view class="lost-ic">?</view>
    <view class="t-title" style="margin-top:16rpx">单据不存在或已删除</view>
    <view class="t-aux" style="margin-top:8rpx">请返回列表重新选择。</view>
    <view class="btn btn-ghost" style="margin-top:32rpx" bindtap="goBack">返回</view>
  </view>

  <block wx:if="{{found}}">

    <!-- ---------- 单据头 ---------- -->
    <view class="head">
      <view class="head-top">
        <text class="head-id num">{{id}}</text>
        <text class="tag {{statusClass}}">{{statusText}}</text>
      </view>
      <view class="head-title">{{title}}</view>
      <view class="head-amt num">¥{{amountText}}</view>
      <view class="head-meta">{{typeLabel}} · {{storeName}}</view>
      <view class="head-meta">{{applicant}}（{{dept}}） · 提交 {{submitDate}}</view>

      <view class="head-pay" wx:if="{{isPayment}}">
        <view class="pay-row">
          <text class="pay-k">收款方</text>
          <text class="pay-v">{{payee}}</text>
        </view>
        <view class="pay-row">
          <text class="pay-k">开户行</text>
          <text class="pay-v">{{payBank}}</text>
        </view>
        <view class="pay-row">
          <text class="pay-k">收款账号</text>
          <text class="pay-v num">{{payeeAccount}}</text>
        </view>
      </view>
    </view>

    <!-- ---------- 审批链 ---------- -->
    <view class="card">
      <view class="card-hd">
        <view class="card-ttl">审批链<text class="sub">{{stepText}}</text></view>
      </view>
      <scroll-view class="flow" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="flow-inner">
          <view class="fnode {{item.state}}" wx:for="{{nodes}}" wx:key="key">
            <view class="fline" wx:if="{{index < nodes.length - 1}}"></view>
            <view class="fdot num">{{item.icon}}</view>
            <view class="fname">{{item.name}}</view>
            <view class="fwho">{{item.who}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- ---------- 处理轨迹 ---------- -->
    <view class="card" wx:if="{{logs.length}}">
      <view class="card-hd">
        <view class="card-ttl">处理轨迹<text class="sub">{{logs.length}} 步</text></view>
      </view>
      <view class="lg" wx:for="{{logs}}" wx:key="key">
        <view class="lg-dot {{item.cls}}"></view>
        <view class="lg-main">
          <view class="lg-top">
            <text class="lg-act">{{item.act}}</text>
            <text class="lg-time num">{{item.time}}</text>
          </view>
          <view class="lg-meta">{{item.by}} · {{item.node}}</view>
          <view class="lg-note" wx:if="{{item.note}}">{{item.note}}</view>
        </view>
      </view>
    </view>

    <!-- ---------- 风险提示 ---------- -->
    <view class="card" wx:if="{{risks.length}}">
      <view class="card-hd">
        <view class="card-ttl">风险提示<text class="sub">{{risks.length}} 条</text></view>
      </view>
      <view class="notice {{item.cls}} risk" wx:for="{{risks}}" wx:key="code">
        <view class="risk-lv">{{item.levelText}}</view>
        <view class="risk-bd">
          <text class="risk-code num">{{item.code}}</text>
          <text>{{item.text}}</text>
        </view>
      </view>
    </view>
    <view class="card" wx:else>
      <view class="notice notice-blue">
        <text>单据校验通过，未发现重复报销、超预算或发票异常。</text>
      </view>
    </view>

    <!-- ---------- 明细 ---------- -->
    <view class="card">
      <view class="card-hd">
        <view class="card-ttl">费用明细<text class="sub">{{lines.length}} 项</text></view>
      </view>

      <view class="tr th">
        <text class="c-item">项目</text>
        <text class="c-qty">数量</text>
        <text class="c-price">单价</text>
        <text class="c-amt">金额</text>
      </view>
      <view class="tr" wx:for="{{lines}}" wx:key="item">
        <text class="c-item">{{item.item}}</text>
        <text class="c-qty num">{{item.qtyText}}</text>
        <text class="c-price num">{{item.priceText}}</text>
        <text class="c-amt num">{{item.amountText}}</text>
      </view>

      <view class="tb-foot">
        <text class="tb-k">合计</text>
        <text class="tb-v num">¥{{amountText}}</text>
      </view>
      <view class="tb-note">含税额 ¥{{taxText}} · 预算科目：{{budgetItem}}</view>
      <view class="tb-note" wx:if="{{note}}">说明：{{note}}</view>
    </view>

    <!-- ---------- 发票 ---------- -->
    <view class="card">
      <view class="card-hd">
        <view class="card-ttl">关联发票<text class="sub">{{invoices.length}} 张</text></view>
      </view>

      <view class="inv" wx:for="{{invoices}}" wx:key="key">
        <view class="inv-top">
          <text class="inv-no num">{{item.codeNo}}</text>
          <text class="inv-amt num">¥{{item.amountText}}</text>
        </view>
        <view class="inv-seller">{{item.seller}}</view>
      </view>

      <view class="empty" style="padding:36rpx 0" wx:if="{{!invoices.length}}">未关联发票</view>
      <view class="tb-note" wx:if="{{invoices.length}}">发票合计 ¥{{invoiceTotalText}} · 其中税额 ¥{{taxText}}</view>
    </view>

    <!-- ---------- 其他附件 ---------- -->
    <view class="card">
      <view class="card-hd">
        <view class="card-ttl">其他附件<text class="sub">非发票材料 · {{attach.length}} 个</text></view>
      </view>
      <view class="att" wx:for="{{attach}}" wx:key="key">
        <text class="tag {{item.cls}}">{{item.kindLabel}}</text>
        <text class="att-name">{{item.name}}</text>
        <text class="att-size">{{item.size}}</text>
      </view>
      <view class="empty" style="padding:32rpx 0" wx:if="{{!attach.length}}">暂无附件。可上传合同、验收单、对账单、现场照片等。</view>
    </view>

    <!-- ---------- 银行回单 ---------- -->
    <view class="card" wx:if="{{isPaid}}">
      <view class="card-hd">
        <view class="card-ttl">银行回单<text class="sub">付款凭证</text></view>
      </view>
      <view class="att" wx:if="{{hasReceipt}}">
        <text class="tag tag-teal">回单</text>
        <text class="att-name">{{receiptName}}</text>
      </view>
      <view class="tb-note" wx:if="{{hasReceipt}}">{{receiptMeta}}</view>
      <view class="empty c-bad" style="padding:28rpx 24rpx" wx:if="{{!hasReceipt}}">
        缺少银行回单。付款已完成但回单未归档，月末关账检查会标记该笔，且无法生成付款凭证。
      </view>
    </view>

  </block>

  <!-- ---------- 底部操作栏 ---------- -->
  <view class="bar" wx:if="{{found}}">
    <block wx:if="{{canAct}}">
      <view class="bar-tip {{hasBlock ? 'c-bad' : ''}}">
        {{hasBlock ? '存在阻断级问题，需先处理' : '当前节点：' + nodeName + ' · ' + nodeWho}}
      </view>
      <view class="bar-btns">
        <view class="btn btn-ghost bar-btn" bindtap="onReject">驳回</view>
        <view class="btn {{hasBlock ? 'btn-disabled' : 'btn-primary'}} bar-btn" bindtap="onApprove">审批通过</view>
      </view>
    </block>

    <block wx:else>
      <view class="bar-denied">
        <view class="bar-dt">{{denyTitle}}</view>
        <view class="bar-dd">{{denyDesc}}</view>
      </view>
    </block>
  </view>

</view>
