/* ================= 待办 ================= */

.who {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx 16rpx;
}

.who-role {
  font-size: 28rpx;
  font-weight: 500;
}

.who-scope {
  font-size: 20rpx;
  color: #8A9099;
  max-width: 62%;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 统计 ---------- */
.stats {
  display: flex;
  align-items: center;
  padding: 22rpx 12rpx;
}

.stat {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.stat-v {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  padding: 0 6rpx;
}

.stat-k {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8A9099;
}

.stat-line {
  width: 1rpx;
  height: 52rpx;
  background: #EDEFF2;
}

/* ---------- 分栏 ---------- */
.tabs {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 20rpx;
}

.tab {
  display: inline-block;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  font-size: 24rpx;
  color: #5A6270;
}

.tab.active {
  background: #185FA5;
  color: #FFFFFF;
  font-weight: 500;
}

.tab-n {
  font-size: 20rpx;
  margin-left: 8rpx;
  opacity: .75;
}

/* ---------- 列表 ---------- */
.list {
  padding: 4rpx 24rpx;
}

.item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #EDEFF2;
}

.item:last-child {
  border-bottom: none;
}

.item-hd {
  display: flex;
  align-items: center;
}

.item-id {
  font-size: 22rpx;
  color: #8A9099;
  margin-right: 12rpx;
}

.item-title {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.45;
}

.item-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #5A6270;
}

.item-foot {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 12rpx;
}

.item-node {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.node-k {
  font-size: 20rpx;
  color: #8A9099;
  margin-right: 8rpx;
}

.node-v {
  font-size: 22rpx;
  color: #185FA5;
}

.item-amt {
  font-size: 30rpx;
  font-weight: 500;
  color: #1B1F24;
}

.item-time {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #A8AEB8;
}

.foot-note {
  padding: 4rpx 0 24rpx;
  text-align: center;
  font-size: 20rpx;
  color: #A8AEB8;
}
