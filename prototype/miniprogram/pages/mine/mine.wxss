/* ================= 我的 ================= */

/* ---------- 身份卡 ---------- */
.idcard {
  background: linear-gradient(135deg, #0C447C 0%, #185FA5 55%, #378ADD 100%);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  color: #FFFFFF;
}

.id-top {
  display: flex;
  align-items: center;
}

.avatar {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .2);
  border: 1rpx solid rgba(255, 255, 255, .34);
  text-align: center;
  font-size: 38rpx;
  font-weight: 500;
}

.id-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.id-name {
  font-size: 34rpx;
  font-weight: 500;
}

.id-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, .78);
}

.id-switch {
  flex: 0 0 auto;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 18rpx;
  margin-left: 12rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, .18);
  border: 1rpx solid rgba(255, 255, 255, .28);
  font-size: 22rpx;
  white-space: nowrap;
}

.id-note {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .18);
  font-size: 20rpx;
  color: rgba(255, 255, 255, .68);
}

/* ---------- 统计 ---------- */
.stats {
  display: flex;
  align-items: center;
  padding: 22rpx 12rpx;
}

.stat {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.stat-v {
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.3;
}

.stat-k {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8A9099;
}

.stat-line {
  width: 1rpx;
  height: 52rpx;
  background: #EDEFF2;
}

/* ---------- 期间 ---------- */
.row-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EDEFF2;
}

.row-line:last-of-type {
  border-bottom: none;
}

.rl-k {
  flex: 0 0 auto;
  font-size: 26rpx;
  color: #5A6270;
}

.rl-v {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #1B1F24;
  word-break: break-all;
}

.rl-scope {
  font-size: 24rpx;
  line-height: 1.5;
}

.rl-note {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #F7F8FA;
  font-size: 20rpx;
  line-height: 1.7;
  color: #8A9099;
}

/* ---------- 功能入口 ---------- */
.menu {
  padding: 4rpx 24rpx;
}

.m-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EDEFF2;
}

.m-item:last-child {
  border-bottom: none;
}

.m-ic {
  flex: 0 0 auto;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 18rpx;
  text-align: center;
  font-size: 26rpx;
}

.qc-blue  { background: #E6F1FB; color: #185FA5; }
.qc-amber { background: #FAEEDA; color: #BA7517; }
.qc-teal  { background: #E1F5EE; color: #0F6E56; }
.qc-red   { background: #FCEBEB; color: #A32D2D; }
.qc-gray  { background: #F1F3F5; color: #5A6270; }

.m-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.m-label {
  font-size: 28rpx;
  color: #1B1F24;
}

.m-sub {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #8A9099;
}

.foot-note {
  padding: 4rpx 0 24rpx;
  text-align: center;
  font-size: 20rpx;
  color: #A8AEB8;
}
