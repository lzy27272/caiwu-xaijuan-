/* ================= 新建单据（报销 / 付款） ================= */

.nd {
  padding: 24rpx 24rpx 220rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: #F5F6F8;
}

/* ---------- 类型切换 ---------- */
.seg {
  display: flex;
  padding: 6rpx;
  background: #E9ECF0;
  border-radius: 18rpx;
  margin-bottom: 20rpx;
}

.seg-i {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5A6270;
  border-radius: 14rpx;
}

.seg-i.on {
  background: #FFFFFF;
  color: #185FA5;
  font-weight: 500;
  box-shadow: 0 2rpx 8rpx rgba(15, 40, 80, .08);
}

/* ---------- 主体说明 ---------- */
.ent {
  margin-bottom: 24rpx;
}

.ent-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #378ADD;
  opacity: .9;
}

/* ---------- 表单行 ---------- */
.fld {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 1rpx solid #EDEFF2;
}

.fld:last-child {
  border-bottom: none;
}

.fld-l {
  width: 200rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #5A6270;
}

.req {
  color: #A32D2D;
  margin-left: 4rpx;
}

.fld-v {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  color: #1B1F24;
  text-align: right;
}

.fld-v.in {
  text-align: right;
}

.fld-v.pick {
  color: #185FA5;
}

.amt-in {
  font-size: 32rpx;
  font-weight: 500;
  color: #185FA5;
}

.hint {
  margin-top: 14rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #8A9099;
}

/* ---------- 常用账户 ---------- */
.accts {
  display: flex;
  padding: 4rpx 0 16rpx;
}

.acct {
  width: 420rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #F7F9FB;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.acct.on {
  background: #E6F1FB;
  border-color: #185FA5;
}

.acct-bank {
  font-size: 24rpx;
  color: #1B1F24;
  font-weight: 500;
}

.acct-no {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5A6270;
  letter-spacing: 1rpx;
}

.acct-meta {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8A9099;
}

/* ---------- 记住账户 ---------- */
.remember {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EDEFF2;
}

.rm-l {
  font-size: 24rpx;
  color: #5A6270;
}

/* ---------- 附件 ---------- */
.att-hint {
  margin: 8rpx 0 18rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #8A9099;
}

.att-btns {
  display: flex;
  margin-bottom: 6rpx;
}

.att-btn {
  flex: 1;
  height: 128rpx;
  margin-right: 16rpx;
  border: 2rpx dashed #C9D3DE;
  border-radius: 16rpx;
  background: #FAFBFD;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #5A6270;
}

.att-btn:last-child {
  margin-right: 0;
}

.att-ic {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #E6F1FB;
  color: #185FA5;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.att {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #EDEFF2;
}

.att:last-child {
  border-bottom: none;
}

.att-mid {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx;
  font-size: 24rpx;
  color: #1B1F24;
}

.att-del {
  font-size: 22rpx;
  color: #A32D2D;
  padding: 4rpx 10rpx;
}

/* ---------- 校验 ---------- */
.chk {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 1.65;
}

.chk-red   { background: #FCEBEB; color: #A32D2D; }
.chk-amber { background: #FAEEDA; color: #933F0F; }

.chk-t {
  font-weight: 500;
  margin-bottom: 4rpx;
}

.chk-x {
  font-size: 22rpx;
  opacity: .95;
}

.ok-card {
  padding: 8rpx;
}

.tip {
  padding: 4rpx 8rpx 20rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: #8A9099;
}

/* ---------- 底部提交栏 ---------- */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EDEFF2;
  box-shadow: 0 -4rpx 20rpx rgba(15, 40, 80, .06);
}

.bar-amt {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.bar-num {
  font-size: 36rpx;
  font-weight: 500;
  color: #185FA5;
}

.bar-btns {
  display: flex;
}

.bar-btns .btn {
  width: 200rpx;
  margin-left: 16rpx;
}

/* ---------- 轻提示 ---------- */
.mp-toast {
  position: fixed;
  left: 50%;
  bottom: 280rpx;
  transform: translateX(-50%);
  max-width: 560rpx;
  padding: 18rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(27, 31, 36, .88);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
  z-index: 99;
}

.mp-toast-err {
  background: rgba(163, 45, 45, .92);
}
