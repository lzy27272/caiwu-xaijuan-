/* ================= 全局样式：设计令牌与通用原子类 =================
   主色 #185FA5 / 深 #0C447C / 浅底 #E6F1FB
   成功 #0F6E56 #E1F5EE · 警告 #BA7517 #FAEEDA · 危险 #A32D2D #FCEBEB
   不使用任何外部图标库与图片，图标位一律用中文单字色块。 */

page {
  --pri: #185FA5;
  --pri-dark: #0C447C;
  --pri-mid: #378ADD;
  --pri-light: #E6F1FB;
  --ok: #0F6E56;
  --ok-bg: #E1F5EE;
  --warn: #BA7517;
  --warn-bg: #FAEEDA;
  --bad: #A32D2D;
  --bad-bg: #FCEBEB;
  --ink: #1B1F24;
  --ink2: #5A6270;
  --ink3: #8A9099;
  --line: #EDEFF2;
  --bg: #F5F6F8;

  background: #F5F6F8;
  color: #1B1F24;
  font-size: 26rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  line-height: 1.5;
}

/* ---------- 布局 ---------- */
.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.card-ttl {
  font-size: 30rpx;
  font-weight: 500;
  color: #1B1F24;
}

.card-ttl .sub,
.card-sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #8A9099;
  margin-left: 10rpx;
}

.card-more {
  font-size: 22rpx;
  color: #185FA5;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.hairline {
  height: 1rpx;
  background: #EDEFF2;
}

/* ---------- 文字 ---------- */
.t-title {
  font-size: 34rpx;
  font-weight: 500;
}

.t-body {
  font-size: 26rpx;
}

.t-aux {
  font-size: 22rpx;
  color: #8A9099;
}

.c1 { color: #1B1F24; }
.c2 { color: #5A6270; }
.c3 { color: #8A9099; }
.c-pri { color: #185FA5; }
.c-ok { color: #0F6E56; }
.c-warn { color: #BA7517; }
.c-bad { color: #A32D2D; }

.bold { font-weight: 500; }

.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.two-line {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 0 12rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 400;
  white-space: nowrap;
}

.tag-blue  { color: #185FA5; background: #E6F1FB; }
.tag-teal  { color: #0F6E56; background: #E1F5EE; }
.tag-amber { color: #BA7517; background: #FAEEDA; }
.tag-red   { color: #A32D2D; background: #FCEBEB; }
.tag-gray  { color: #5A6270; background: #F1F3F5; }

/* ---------- 按钮（view 实现，避免原生 button 默认样式） ---------- */
.btn {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

.btn-primary {
  background: #185FA5;
  color: #FFFFFF;
}

.btn-ghost {
  background: #FFFFFF;
  color: #5A6270;
  border: 1rpx solid #E3E6EA;
}

.btn-danger {
  background: #FCEBEB;
  color: #A32D2D;
  border: 1rpx solid #F3D3D3;
}

.btn-disabled {
  background: #EEF0F3;
  color: #A8AEB8;
}

.btn:active {
  opacity: .82;
}

/* ---------- 列表 ---------- */
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #EDEFF2;
}

.cell:last-child {
  border-bottom: none;
}

.cell-label {
  font-size: 26rpx;
  color: #5A6270;
}

.cell-value {
  font-size: 26rpx;
  color: #1B1F24;
  text-align: right;
}

.cell-arrow {
  font-size: 22rpx;
  color: #B6BCC4;
  margin-left: 8rpx;
}

/* ---------- 空态 ---------- */
.empty {
  padding: 72rpx 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8A9099;
  line-height: 1.7;
}

/* ---------- 横向滚动（隐藏滚动条） ---------- */
.hscroll {
  white-space: nowrap;
}

.hscroll::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* ---------- 提示条 ---------- */
.notice {
  display: flex;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.notice-red   { background: #FCEBEB; color: #A32D2D; }
.notice-amber { background: #FAEEDA; color: #933F0F; }
.notice-blue  { background: #E6F1FB; color: #0C447C; }
